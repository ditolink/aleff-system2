# Copie este arquivo para .env e preencha.
# NUNCA commite o .env no GitHub.

FLASK_ENV=production
HOST=127.0.0.1
PORT=3001

SECRET_KEY=troque-por-uma-string-longa-aleatoria

# Contas (troque as senhas)
DEV_USER=sanmuel
DEV_PASSWORD=SENHA_DEV_AQUI
ADMIN_USER=aleff
ADMIN_PASSWORD=SENHA_ADMIN_AQUI
AUTH_USERS=sanmuel:SENHA_DEV_AQUI:dev,aleff:SENHA_ADMIN_AQUI:admin

SESSION_DAYS=90
SESSION_COOKIE_SECURE=false
API_LOCKDOWN=true
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,https://aleffthiago.com.br,https://www.aleffthiago.com.br

CLIP_ENABLED=true
CODE_VIEWER_ENABLED=false
PUBLIC_DRIVE_FILES=false
MAX_CONTENT_LENGTH=524288000

# Google Drive — ID da pasta compartilhada com a service account
DRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA_AQUI

# Caminho do JSON da service account (arquivo local, fora do git)
# OU cole o JSON inteiro numa linha (não recomendado no GitHub)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Opcional
# ADMIN_API_KEY=
# HF_API_TOKEN=
# TRUST_PROXY=true
# ALLOWED_HOSTS=aleffthiago.com.br,www.aleffthiago.com.br
# RATE_API_PER_MIN=120
# RATE_SEARCH_PER_MIN=60
# RATE_AUTH_PER_MIN=40
