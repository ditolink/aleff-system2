# Copie este arquivo para .env e preencha.
# NUNCA commite o .env no GitHub.

FLASK_ENV=production
HOST=127.0.0.1
PORT=3001

SECRET_KEY=troque-por-uma-string-longa-aleatoria

# Contas (troque as senhas)
DEV_USER=sanmuel
DEV_PASSWORD=SENHA_DEV_AQUI
ADMIN_USER=aleff
ADMIN_PASSWORD=SENHA_ADMIN_AQUI
AUTH_USERS=sanmuel:SENHA_DEV_AQUI:dev,aleff:SENHA_ADMIN_AQUI:admin

SESSION_DAYS=90
SESSION_COOKIE_SECURE=false
API_LOCKDOWN=true
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,https://aleffthiago.com.br,https://www.aleffthiago.com.br

CLIP_ENABLED=true
# Busca: CLIP no request deixa a resposta lenta (CPU). Deixe 0.
SEARCH_USE_CLIP=0
# Boot: NÃO force OpenCLIP/Faces (come RAM e atrasa Drive/site).
# Use Warmup/Backfill no dashboard Dev quando quiser.
CLIP_WARMUP_ON_START=0
CLIP_BACKFILL_ON_START=0
FACE_ENABLED=true
FACE_WARMUP_ON_START=0
FACE_BACKFILL_ON_START=0
# FACE_SIM_THRESHOLD=0.42
# FACE_MODEL=buffalo_l
THUMB_PREFETCH_ON_START=1
CODE_VIEWER_ENABLED=false
PUBLIC_DRIVE_FILES=false
MAX_CONTENT_LENGTH=524288000

# Google Drive — ID da pasta compartilhada com a service account
DRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA_AQUI

# Sync: busca EXIF (data real da foto) só em arquivos novos — 0 desliga
SYNC_FETCH_EXIF=1

# Caminho do JSON da service account (arquivo local, fora do git)
# OU cole o JSON inteiro numa linha (não recomendado no GitHub)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Opcional
# ADMIN_API_KEY=
# HF_API_TOKEN=
# TRUST_PROXY=true
# ALLOWED_HOSTS=aleffthiago.com.br,www.aleffthiago.com.br
# RATE_API_PER_MIN=120
# RATE_SEARCH_PER_MIN=60
# RATE_AUTH_PER_MIN=40

# ── Observabilidade ──
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_ENABLED=0
# OTEL_SERVICE_NAME=aleff-system2
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# (Datadog / New Relic: aponte OTLP para o collector do vendor)