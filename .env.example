# Copie este arquivo para .env e preencha.
# NUNCA commite o .env no GitHub.

FLASK_ENV=production
HOST=127.0.0.1
PORT=3001

SECRET_KEY=troque-por-uma-string-longa-aleatoria

# Contas — preferir HASH (werkzeug) em produção; plain só em dev local
# Gerar: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('sua-senha'))"
DEV_USER=sanmuel
DEV_PASSWORD=SENHA_DEV_AQUI
# DEV_PASSWORD_HASH=scrypt:32768:8:1$...
ADMIN_USER=aleff
ADMIN_PASSWORD=SENHA_ADMIN_AQUI
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...
AUTH_USERS=sanmuel:SENHA_DEV_AQUI:dev,aleff:SENHA_ADMIN_AQUI:admin

# Sessão: produção default 14d; Secure=true fail-closed em FLASK_ENV=production
SESSION_DAYS=14
SESSION_COOKIE_SECURE=false
API_LOCKDOWN=true
# Nunca use * — credentials + wildcard = falha / risco
CORS_ORIGINS=http://127.0.0.1:3001,http://localhost:3001,https://aleffthiago.com.br,https://www.aleffthiago.com.br

# Originais HD públicos? Default OFF. Em produção exige também PUBLIC_MEDIA_ORIGINALS_CONFIRM=i-understand
PUBLIC_MEDIA_ORIGINALS=false
# PUBLIC_MEDIA_ORIGINALS_CONFIRM=

CLIP_ENABLED=true
# Busca: CLIP no request deixa a resposta lenta (CPU). Deixe 0.
SEARCH_USE_CLIP=0
# Boot: NÃO force OpenCLIP/Faces (come RAM e atrasa Drive/site).
# Use Warmup/Backfill no dashboard Dev quando quiser.
CLIP_WARMUP_ON_START=0
CLIP_BACKFILL_ON_START=0
FACE_ENABLED=true
FACE_WARMUP_ON_START=0
FACE_BACKFILL_ON_START=0
FACE_FOCUS_BACKFILL_ON_START=1
# Sync/upload NÃO carrega modelo sozinho (evita site “travado ligando IA”).
AI_INDEX_ON_SYNC=0
AI_INDEX_ON_UPLOAD=0
# FACE_SIM_THRESHOLD=0.42
# FACE_MODEL=buffalo_l
THUMB_PREFETCH_ON_START=1
# THUMB_WARM_LIMIT=240
# THUMB_WARM_WORKERS=8
# THUMB_PLAN_CACHE_TTL=45
CODE_VIEWER_ENABLED=false
PUBLIC_DRIVE_FILES=false
MAX_CONTENT_LENGTH=524288000

# Google Drive — ID da pasta compartilhada com a service account
DRIVE_FOLDER_ID=COLE_O_ID_DA_PASTA_AQUI

# Sync: busca EXIF (data real da foto) só em arquivos novos — 0 desliga
SYNC_FETCH_EXIF=1

# ── Performance (site no ar) ──
# Cache em memória da busca (segundos). Produção: 60–180.
# SEARCH_CACHE_TTL=90
# SEARCH_CACHE_MAX=128
# HOME_POOL_CACHE_TTL=120
# HOME_POOL_LIMIT=360
# HOME_POOL_MAX_PER_PASTA=3
# THEME_POOL_LIMIT=600
# THEME_MAX_PER_PASTA=24
# Thumbs pré-render (WebP) — boot gera medium/small em paralelo
# THUMB_SMALL_PX=320
# THUMB_MEDIUM_PX=800
# THUMB_SMALL_Q=62
# THUMB_MEDIUM_Q=78
# Persistência obrigatória: ./data (media.db, thumbs/, media_cache/)

# Caminho do JSON da service account (arquivo local, fora do git)
# OU cole o JSON inteiro numa linha (não recomendado no GitHub)
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# Produção (Oracle + nginx) — descomente/ajuste na VM:
# TRUST_PROXY=true
# SESSION_COOKIE_SECURE=true
# ALLOWED_HOSTS=aleffthiago.com.br,www.aleffthiago.com.br

# Opcional
# ADMIN_API_KEY=
# HF_API_TOKEN=
# RATE_API_PER_MIN=120
# RATE_SEARCH_PER_MIN=60
# RATE_AUTH_PER_MIN=40
# RATE_THUMBS_PER_MIN=600
# RATE_THUMBS_WARM_PER_MIN=6
# RATE_THUMBS_PLAN_PER_MIN=30
# RATE_DOWNLOAD_PER_MIN=40
# SEARCH_STATS_CACHE_SEC=180

# ── Observabilidade ──
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# OTEL_ENABLED=0
# OTEL_SERVICE_NAME=aleff-system2
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
# (Datadog / New Relic: aponte OTLP para o collector do vendor)