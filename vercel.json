{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "frontend/**"
        ],
        "excludeFiles": [
          "frontend/videos/*.mp4",
          "frontend/videos/*.mov",
          "frontend/videos/*.avi"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/server.py"
    }
  ]
}
